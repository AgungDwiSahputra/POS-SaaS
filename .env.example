APP_NAME="Ez POS"
APP_ENV=local
APP_KEY=base64:b+c83Gg0jCVW2nuTmQ8KJvIWzyjDssCPgNHIXYCAlQI=
APP_DEBUG=true
APP_URL=https://pos.ezakses.test
SESSION_DOMAIN=.ezakses.test
SANCTUM_STATEFUL_DOMAINS=pos.ezakses.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE="pos-ezakses"
DB_USERNAME="root"
DB_PASSWORD=""

# Database Query Logging (Selective - Only Errors & Slow Queries)
DB_QUERY_LOGGING=true
DB_SLOW_QUERY_THRESHOLD=1000
DB_ERROR_THRESHOLD=5000
DB_LOG_PARAMETERS=true
DB_LOG_DUPLICATES=false
DB_MAX_QUERY_LENGTH=1000
# Selective logging options
DB_LOG_ERRORS=true
DB_LOG_SLOW_QUERIES=true
DB_LOG_FAILED_QUERIES=true
DB_LOG_SUCCESSFUL_QUERIES=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=5000

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME="username"
MAIL_PASSWORD="password"
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="from@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MEDIA_DISK=public
SANCTUM_TTL=5000

UPGRADE_MODE=false

STRIPE_KEY=
STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=

## RazorPay Config
RAZOR_KEY=
RAZOR_SECRET=

MIX_RAZOR_KEY="${RAZOR_KEY}"
MIX_RAZOR_SECRET="${RAZOR_SECRET}"
